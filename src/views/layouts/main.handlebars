<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <div id="pageId" class="d-none">{{pageId}}</div>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="/">🛒 Coder E-commerce</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a id="nav-home" class="nav-link active" href="/"
                                _="on load if #pageId.innerHTML is '1' add .active to me else remove .active from me">Home</a>
                        </li>
                        <li class="nav-item">
                            <a id="nav-products" class="nav-link" href="/products"
                                _="on load if #pageId.innerHTML is '3' add .active to me else remove .active from me">Produtos</a>
                        </li>
                        <li class="nav-item">
                            <a id="nav-realtime" class="nav-link" href="/realtimeproducts"
                                _="on load if #pageId.innerHTML is '2' add .active to me else remove .active from me">Produtos
                                em Tempo Real</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <button class="btn btn-outline-light" 
                                onclick="goToCart()"
                                title="Ver Carrinho">
                                <i class="fas fa-shopping-cart"></i> Carrinho
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-5">
        {{{body}}}
    </main>

    <footer class="footer text-bg-dark mt-auto py-3">
        <div class="container text-center">
            <span>&copy; 2025 - Coder E-commerce</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://unpkg.com/hyperscript.org@0.9.14"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
    function goToCart() {
        const cartId = localStorage.getItem('cartId');
        if (cartId) {
            window.location.href = `/carts/${cartId}`;
        } else {
            Swal.fire({
                icon: 'info',
                title: 'Carrinho vazio',
                text: 'Adicione alguns produtos primeiro!',
                confirmButtonText: 'Ver Produtos'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/products';
                }
            });
        }
    }
    </script>

</body>

</html>