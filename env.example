# Configuração do Banco de Dados MongoDB
# Para MongoDB local:
MONGO_URI=mongodb://localhost:27017/ecommerce

# Para MongoDB Atlas (substitua com sua string de conexão):
# MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/ecommerce?retryWrites=true&w=majority

# Porta do servidor (opcional, padrão: 8080)
PORT=8080

# Ambiente de execução (opcional)
NODE_ENV=development 