{
	"info": {
		"_postman_id": "products-api-collection",
		"name": "Products API - MongoDB",
		"description": "Coleção para testar a API de produtos com MongoDB, paginação e filtros",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Products",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has pagination structure', function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response).to.have.property('status');",
							"    pm.expect(response).to.have.property('payload');",
							"    pm.expect(response).to.have.property('totalPages');",
							"    pm.expect(response).to.have.property('page');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products"]
				}
			}
		},
		{
			"name": "Get Products with Pagination",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products?limit=5&page=1",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products"],
					"query": [
						{
							"key": "limit",
							"value": "5"
						},
						{
							"key": "page",
							"value": "1"
						}
					]
				}
			}
		},
		{
			"name": "Get Products with Sort Ascending",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products?sort=asc",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products"],
					"query": [
						{
							"key": "sort",
							"value": "asc"
						}
					]
				}
			}
		},
		{
			"name": "Get Products with Sort Descending",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products?sort=desc",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products"],
					"query": [
						{
							"key": "sort",
							"value": "desc"
						}
					]
				}
			}
		},
		{
			"name": "Get Available Products",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products?query=available",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products"],
					"query": [
						{
							"key": "query",
							"value": "available"
						}
					]
				}
			}
		},
		{
			"name": "Get Products by Category",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products?query=smartphones",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products"],
					"query": [
						{
							"key": "query",
							"value": "smartphones"
						}
					]
				}
			}
		},
		{
			"name": "Get Products Combined Filters",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products?limit=10&page=1&sort=asc&query=available",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products"],
					"query": [
						{
							"key": "limit",
							"value": "10"
						},
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "sort",
							"value": "asc"
						},
						{
							"key": "query",
							"value": "available"
						}
					]
				}
			}
		},
		{
			"name": "Get Product by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Product has required fields', function () {",
							"    const product = pm.response.json();",
							"    pm.expect(product).to.have.property('_id');",
							"    pm.expect(product).to.have.property('title');",
							"    pm.expect(product).to.have.property('price');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products/{{productId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products", "{{productId}}"]
				}
			}
		},
		{
			"name": "Create Product",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Product created successfully', function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response).to.have.property('product');",
							"    pm.globals.set('newProductId', response.product._id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Produto Teste MongoDB\",\n  \"description\": \"Produto criado para testar a API com MongoDB\",\n  \"code\": \"TEST-MONGO-001\",\n  \"price\": 199.99,\n  \"status\": true,\n  \"stock\": 50,\n  \"category\": \"teste\",\n  \"thumbnails\": [\"test1.jpg\", \"test2.jpg\"]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/products",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products"]
				}
			}
		},
		{
			"name": "Update Product",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"price\": 299.99,\n  \"stock\": 75\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/products/{{newProductId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products", "{{newProductId}}"]
				}
			}
		},
		{
			"name": "Delete Product",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products/{{newProductId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products", "{{newProductId}}"]
				}
			}
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "",
			"type": "string"
		}
	]
}